---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';
import {contacts, hours, site, waLink} from '../data/site';
import {pic} from '../lib/photos';
import {faqSchema, type Faq as FaqItem} from '../lib/schema';

const crumbs = [
  {name: 'Home', href: '/'},
  {name: 'Contact', href: '/contact/'},
];
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.mapQuery)}&output=embed`;

const faqs: FaqItem[] = [
  {q: 'What is the address of The Duckpond?', a: `${site.address.oneLine}. Search “The Duck Pond Ballito” in Google Maps for directions.`},
  {q: 'Who do I contact for venue bookings?', a: contacts.slice(0, 3).map((c) => `${c.name} on ${c.display}`).join(', ') + `, or email ${site.email.bookings}.`},
  {q: 'Who do I contact for accommodation?', a: `Denny on 073 631 3045, or email ${site.email.accommodation}.`},
  {q: 'Can I WhatsApp you?', a: 'Yes, all our booking numbers are on WhatsApp.'},
];
---

<Base
  title="Contact The Duckpond | R102 Greylands Road, Ballito | 083 666 6565"
  description="Contact The Duckpond on the R102 between Ballito and Tongaat. Call or WhatsApp 083 666 6565, email bookings@theduckpond.co.za, or get directions and venue hours."
  crumbs={crumbs}
  schema={[faqSchema(faqs)]}
>
  <PageHero
    eyebrow="Contact · Directions · Hours"
    lines={[{t: 'Come and'}, {t: 'say hello', i: true}]}
    intro={`Call, WhatsApp or email us, or come and see us on the R102 between Ballito and Tongaat.`}
    images={[pic('sunset-pond-reflection')]}
    crumbs={crumbs}
  >
    <a href={`tel:${site.phone.tel}`} class="btn btn-primary">Call {site.phone.display}</a>
    <a href={waLink('Hi The Duckpond, I have a question.')} class="btn btn-ghost" rel="noopener" target="_blank">WhatsApp</a>
  </PageHero>

  <Section eyebrow="Talk to our team" lines={[{t: 'Call or'}, {t: 'WhatsApp', i: true}]}>
    <ul class="grid gap-x-10 gap-y-8 sm:grid-cols-2" data-reveal>
      {
        contacts.map((c) => (
          <li class="border-t border-ink/25 pt-5">
            <h3 class="display text-[34px]">{c.name}</h3>
            <p class="caps text-forest">{c.role}</p>
            <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
              <a href={`tel:${c.tel}`} class="text-[19px] underline underline-offset-4 hover:text-raspberry">
                {c.display}
              </a>
              <a href={`https://wa.me/${c.wa}`} class="caps inline-flex min-h-[44px] items-center hover:text-raspberry" rel="noopener" target="_blank">
                WhatsApp <span class="sr-only">{c.name}</span>
              </a>
            </p>
          </li>
        ))
      }
    </ul>
    <div class="mt-12 grid gap-8 sm:grid-cols-2" data-reveal>
      <div>
        <h3 class="caps text-ink/70">Bookings &amp; venues</h3>
        <a href={`mailto:${site.email.bookings}`} class="mt-1 block text-[19px] break-all underline underline-offset-4 hover:text-raspberry">{site.email.bookings}</a>
      </div>
      <div>
        <h3 class="caps text-ink/70">Accommodation</h3>
        <a href={`mailto:${site.email.accommodation}`} class="mt-1 block text-[19px] break-all underline underline-offset-4 hover:text-raspberry">{site.email.accommodation}</a>
      </div>
    </div>
  </Section>

  <section class="bg-cream py-20 md:py-28" aria-labelledby="find-us">
    <div class="mx-auto grid max-w-[1680px] gap-10 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-4" data-reveal>
        <p class="caps text-forest">Find us</p>
        <h2 id="find-us" class="display mt-4 text-[clamp(40px,5vw,84px)]"><span class="block">Directions</span><span class="it block">& hours</span></h2>
        <address class="mt-8 text-[18px] not-italic">
          The Duckpond<br />R102, Greylands Road<br />Between Ballito &amp; Tongaat<br />KwaZulu-Natal, South Africa
        </address>
        <p class="copy mt-5">
          From Ballito, take the R102 south towards Tongaat; from Tongaat, head north on the R102 towards Ballito. Look for
          The Duckpond signs on Greylands Road.
        </p>
        <h3 class="caps mt-8 text-ink/70">Venue hours</h3>
        <ul class="mt-2 space-y-1">
          {hours.map((h) => <li>{h.days}: <span class="whitespace-nowrap">{h.time}</span></li>)}
        </ul>
        <a
          href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(site.mapQuery)}`}
          class="btn btn-forest mt-8"
          rel="noopener"
          target="_blank">Get directions</a
        >
      </div>
      <div class="md:col-span-8" data-reveal>
        <iframe
          title="Map showing The Duckpond on the R102 between Ballito and Tongaat"
          src={mapSrc}
          class="aspect-[4/3] w-full border-0 md:aspect-auto md:h-full md:min-h-[520px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>

  <Section eyebrow="Follow along" lines={[{t: 'Facebook'}, {t: '& Instagram', i: true}]}>
    <div class="copy text-[18px]" data-reveal>
      <p>New specials, events and photos are posted first on our social pages.</p>
    </div>
    <div class="mt-8 flex flex-wrap gap-3" data-reveal>
      <a href={site.social.facebook} class="btn btn-forest" rel="noopener" target="_blank">The Duck Pond on Facebook</a>
      <a href={site.social.instagram} class="btn btn-ghost" rel="noopener" target="_blank">@ballitoduckpond</a>
    </div>
  </Section>

  <Faq items={faqs} />
</Base>
