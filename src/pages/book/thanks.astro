---
// Shown by Netlify after a form is sent without JavaScript.
import Base from '../../layouts/Base.astro';
import {contacts} from '../../data/site';
---

<Base title="Thank you | The Duckpond" description="Your request has been sent to The Duckpond." noindex>
  <section class="on-dark flex min-h-svh items-center bg-forest py-32 text-white">
    <div class="mx-auto w-full max-w-[1680px] px-5 md:px-14">
      <p class="caps text-white/80">Request sent</p>
      <h1 class="display mt-4 text-[clamp(52px,8vw,140px)]"><span class="block">Thank</span><span class="it block">you.</span></h1>
      <p class="mt-8 max-w-[52ch] text-[18px] text-white/90">
        Your message is with our team. We will check availability and reply to confirm. For anything urgent, call or
        WhatsApp {contacts[0].name} on <a class="underline" href={`tel:${contacts[0].tel}`}>{contacts[0].display}</a>.
      </p>
      <a href="/" class="btn btn-ghost mt-10">Back to home</a>
    </div>
  </section>
</Base>
